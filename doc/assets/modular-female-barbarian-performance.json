{
  "date": "2026-10-16",
  "target": "60 FPS rendering with ten skirted female barbarians; prioritize runtime cost over precise cloth collision.",
  "strategy": {
    "implementation": "Reuse the existing bone-driven robe rig for the four female barbarian skirt panels. The panels share one waist hinge baked by tools/prepare-female-knight.mjs, so each character gets one extended skeleton. Preserve authored attachment vertices and the top attachment band.",
    "physics_hz": 30,
    "shared_static_skirt_geometries_for_ten_characters": 4,
    "per_frame_skirt_vertex_uploads": 0,
    "tradeoff": "Each hem column lifts until it clears the thigh colliders (70% of that angle) and, while the legs swing, also follows the thigh axis (up to 1.35 rad). Standing poses hang close to the pelt result; running keeps its bounce. Slight thigh overlap in big poses; no per-vertex collision or length constraints.",
    "control_bones_per_character": 6,
    "robe_skeletons_per_character": 1
  },
  "method": "Game-scale female barbarians with baked boots tracks; one local at 60 Hz, remaining characters on the game remote scheduler at 30 Hz. 30 warmup and 120 measured frames per clip. mean/median/p95 cover aggregate CPU physics including world matrices; animation_and_physics_mean_ms also includes mixers and scheduling. Rendering is excluded; these are CPU costs, not game FPS.",
  "runtime": "v25.2.1",
  "scope": "CPU timings include world matrices and the actual local/remote scheduling. They exclude rendering, terrain, vegetation and buildings. They do not establish full Haramen FPS on the user browser.",
  "reproduce": [
    "node tools/benchmark-female-barbarian.mjs --count=1 --output=/tmp/female-single.json",
    "node tools/benchmark-female-barbarian.mjs --count=10 --legacy --output=/tmp/female-crowd-before.json",
    "node tools/benchmark-female-barbarian.mjs --count=10 --output=/tmp/female-crowd-after.json"
  ],
